{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/open-checking", "destination": "/checking", "statusCode": 301 },
    { "source": "/banking/private-checking", "destination": "/checking", "statusCode": 301 },
    { "source": "/banking/private-savings", "destination": "/savings", "statusCode": 301 },
    { "source": "/banking/credit-card", "destination": "/credit-card", "statusCode": 301 },
    { "source": "/banking/retirement-401k", "destination": "/retirement", "statusCode": 301 },
    { "source": "/loans/personal", "destination": "/loans", "statusCode": 301 },
    { "source": "/loans/auto", "destination": "/loans", "statusCode": 301 },
    { "source": "/banking/digital-asset-lending", "destination": "/loans", "statusCode": 301 },
    { "source": "/mission", "destination": "/about", "statusCode": 301 },
    { "source": "/membership", "destination": "/open-account", "statusCode": 301 },
    { "source": "/faq", "destination": "/resources", "statusCode": 301 },
    { "source": "/fraud-prevention", "destination": "/security", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/personal-banking", "destination": "/personal-banking.html" },
    { "source": "/private-wealth", "destination": "/private-wealth.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/resources", "destination": "/resources.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/checking", "destination": "/checking.html" },
    { "source": "/savings", "destination": "/savings.html" },
    { "source": "/credit-card", "destination": "/credit-card.html" },
    { "source": "/loans", "destination": "/loans.html" },
    { "source": "/retirement", "destination": "/retirement.html" },
    { "source": "/open-account", "destination": "/open-account.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/accessibility", "destination": "/accessibility.html" },
    { "source": "/disclosures", "destination": "/disclosures.html" },
    { "source": "/cryptocurrency", "destination": "/cryptocurrency.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    }
  ]
}
