{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/app"
    },
    {
      "source": "/services/ach",
      "destination": "/app"
    },
    {
      "source": "/services/mobile-deposit",
      "destination": "/app"
    },
    {
      "source": "/services/check-deposit",
      "destination": "/app"
    },
    {
      "source": "/services/wire",
      "destination": "/app"
    },
    {
      "source": "/services/transfer",
      "destination": "/app"
    },
    {
      "source": "/services/bill-pay",
      "destination": "/app"
    },
    {
      "source": "/services/virtual-card",
      "destination": "/app"
    },
    {
      "source": "/services/digital-assets-trade",
      "destination": "/app"
    },
    {
      "source": "/statements",
      "destination": "/app"
    },
    {
      "source": "/alerts",
      "destination": "/app"
    },
    {
      "source": "/(login|sign-in|register|signup|forgot-password|reset-password|auth/callback|dashboard|accounts|activation|transactions|insights|profile|settings|support|admin)",
      "destination": "/app"
    },
    {
      "source": "/(login|sign-in|register|signup|forgot-password|reset-password|dashboard|accounts|activation|transactions|insights|profile|settings|support|admin)/:rest*",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/services/(ach|mobile-deposit|check-deposit|wire)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(login|sign-in|register|signup|forgot-password|reset-password|auth/callback|dashboard|accounts|activation|transactions|insights|profile|settings|support|admin)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(login|sign-in|register|signup|forgot-password|reset-password|dashboard|accounts|activation|transactions|insights|profile|settings|support|admin)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
