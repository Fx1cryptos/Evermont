# Copy to .env.local and fill in.
# Set the isolated staging project URL and its matching public key.
# Preview only: bind STAGING_SUPABASE_PROJECT_REF independently from the staging
# project's settings. Use the same pin and URLs in the build, API and scheduler.
# STAGING_SUPABASE_PROJECT_REF=
# Set VERCEL_ENV=preview in the private staging runner outside Vercel.
# The Vercel Production target remains pinned to gdodqiwjcezdznzroupw.
# Never put a service-role key, secret key, JWT secret, or database password here.
VITE_SUPABASE_URL=
# Preferred public key; legacy anon key remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Vercel server only; configure independently of Vite. No VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional support email integration (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
SUPPORT_NOTIFICATION_EMAIL=

# Isolated Django demo process environment; never point at the member database.
DEMO_DEBUG=1
DEMO_SECRET_KEY=
DEMO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DEMO_CSRF_TRUSTED_ORIGINS=
# DEMO_DATABASE=/absolute/path/to/demo.sqlite3
DEMO_REDIS_URL=redis://127.0.0.1:6379/0

# Optional server-only first-line assistant. Use a generateContent model enabled in your Google AI project.
GEMINI_API_KEY=
GEMINI_MODEL=
